        <item name="colorSecondary">@color/clean_paper_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorOnSurface">@color/clean_paper_text</item>
        <item name="colorOnSurfaceVariant">@color/clean_paper_text_secondary</item>
        <item name="colorOutline">@color/clean_paper_divider</item>
        <item name="android:textColor">@color/clean_paper_text</item>
        <item name="android:textColorPrimary">@color/clean_paper_text</item>
        <item name="android:textColorSecondary">@color/clean_paper_text_secondary</item>
        <item name="android:textColorHint">@color/clean_paper_text_muted</item>
        <item name="android:editTextColor">@color/clean_paper_text</item>
        <item name="colorOnBackground">@color/clean_paper_text</item>

        <!-- Custom Chord & Secondary Accent -->
        <item name="colorChordText">@color/clean_paper_accent</item>
        <item name="colorAccentSecondary">@color/clean_paper_secondary</item>

        <!-- Window bar styling -->
        <item name="android:statusBarColor">@color/clean_paper_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/clean_paper_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

