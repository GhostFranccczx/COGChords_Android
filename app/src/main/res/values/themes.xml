<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. Dark Stage Theme (great for gigs and late-night practice) -->
    <style name="Theme.COGChords.DarkStage" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/dark_stage_bg</item>
        <item name="colorSurface">@color/dark_stage_surface</item>
        <item name="colorSurfaceVariant">@color/dark_stage_badge_bg</item>
        <item name="colorPrimary">@color/dark_stage_accent</item>
        <item name="colorOnPrimary">@color/dark_stage_bg</item>
        <item name="colorSecondary">@color/dark_stage_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorOnSurface">@color/dark_stage_text</item>
        <item name="colorOnSurfaceVariant">@color/dark_stage_text_secondary</item>
        <item name="colorOutline">@color/dark_stage_divider</item>
        <item name="android:textColor">@color/dark_stage_text</item>
        <item name="android:textColorPrimary">@color/dark_stage_text</item>
        <item name="android:textColorSecondary">@color/dark_stage_text_secondary</item>
        <item name="android:textColorHint">@color/dark_stage_text_muted</item>
        <item name="android:editTextColor">@color/dark_stage_text</item>
        <item name="colorOnBackground">@color/dark_stage_text</item>

        <!-- Custom Chord & Secondary Accent -->
        <item name="colorChordText">@color/dark_stage_accent</item>
        <item name="colorAccentSecondary">@color/dark_stage_secondary</item>

        <!-- Window bar styling -->
        <item name="android:statusBarColor">@color/dark_stage_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/dark_stage_surface</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- 2. Clean Paper Theme (feels like a songbook) -->
