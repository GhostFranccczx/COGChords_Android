<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_card_mono"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Chord Name -->
    <TextView
        android:id="@+id/tv_chord_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Am" />

    <!-- Quality Badge -->
    <TextView
        android:id="@+id/tv_chord_quality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_key_badge"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="10sp"
        tools:text="Minor" />

    <!-- Fretboard Diagram -->
    <com.example.cogchords.ui.chords.ChordDiagramView
        android:id="@+id/chord_diagram_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <!-- Frets String Formula -->
    <TextView
        android:id="@+id/tv_chord_frets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        tools:text="X 0 2 2 1 0" />

</LinearLayout>
