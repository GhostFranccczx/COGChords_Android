<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_mono"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Song Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_song_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Amazing Grace" />

        <TextView
            android:id="@+id/tv_song_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="John Newton" />

        <!-- Badges: Key and Category -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_song_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_key_badge"
                android:fontFamily="monospace"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Key: G" />

            <TextView
                android:id="@+id/tv_song_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_key_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                tools:text="Hymn" />

        </LinearLayout>

    </LinearLayout>

    <!-- More Options Button -->
    <ImageView
        android:id="@+id/btn_song_options"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Song Options"
        android:padding="8dp"
        android:src="@drawable/ic_more_vert"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
